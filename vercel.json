{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/how-tamva-works",
      "destination": "/how-tamva-works/index.html"
    },
    {
      "source": "/how-tamva-works/",
      "destination": "/how-tamva-works/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tamva.onrender.com/:path*"
    }
  ]
}
