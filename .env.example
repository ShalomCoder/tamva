# Base URL used by the browser API client.
#   "/api"  -> requests are proxied by the Vite dev/preview server to
#              VITE_PROXY_TARGET (no CORS needed). Recommended for local dev.
#   "https://tamva.onrender.com" -> call the backend directly. Requires the
#              backend to allow this origin (ENABLE_CORS=true + ALLOWED_ORIGINS).
VITE_API_BASE_URL=/api

# Where the Vite dev/preview proxy forwards "/api" requests.
VITE_PROXY_TARGET=https://tamva.onrender.com

# Optional: prefill the login screen.
VITE_DEFAULT_EMAIL=admin@tamva.local
VITE_DEFAULT_PASSWORD=StrongPass123!
